---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Contact" 
  description="Contact us for reservations and further information about Homestay Slamet Widodo."
  lang="en"
>
  <section class="bg-terracotta-500 py-20 px-4 text-center">
    <div class="container mx-auto">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-cream-100 mb-4">Contact Us</h1>
      <p class="text-xl text-cream-200 max-w-2xl mx-auto">
        We are ready to assist you in planning your stay in Borobudur.
      </p>
    </div>
  </section>

  <section class="py-16 px-4 bg-cream-50 min-h-screen">
    <div class="container mx-auto max-w-5xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Info Kontak -->
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-cream-200 flex flex-col justify-center">
          <h2 class="text-3xl font-serif font-bold text-terracotta-500 mb-8">Reservation & Information</h2>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="bg-terracotta-100 text-terracotta-500 p-3 rounded-full shrink-0">
                <!-- Icon Location -->
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-lg text-terracotta-500 mb-1">Address</h3>
                <p class="text-terracotta-400">
                  Sembungan, RT.01/RW.01, Sendaran, Kembanglimus,<br/> 
                  Kec. Borobudur, Kabupaten Magelang, Jawa Tengah 56553
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="bg-[#e8f5e9] text-[#20A83E] p-3 rounded-full shrink-0">
                <!-- Icon WA -->
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-lg text-[#20A83E] mb-1">WhatsApp</h3>
                <p class="text-terracotta-400 mb-2">+62 882-2538-6498</p>
                <a href="https://wa.me/6288225386498?text=Hello%2C%20I%20want%20to%20ask%20about%20room%20availability%20at%20Homestay%20Slamet%20Widodo" target="_blank" class="inline-block text-sm font-bold bg-[#20A83E] hover:bg-[#189433] text-white py-2 px-4 rounded-full transition-colors">
                  Chat Now
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Google Maps Embed -->
        <div class="bg-cream-200 rounded-3xl overflow-hidden shadow-sm h-[400px] lg:h-auto border-4 border-white relative">
          <!-- Menggunakan koordinat spesifik Homestay Widodo (C52J+H8 Kembanglimus) -->
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1m3!1d3954.195655762283!2d110.187811!3d-7.619047!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a8cf61f438a2d%3A0xc4f63c800c8b0!2sHomestay%20Slamet%20Widodo!5e0!3m2!1sen!2sid!4v1700000000000!5m2!1sen!2sid" 
            class="absolute inset-0 w-full h-full border-0"
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>

      </div>
    </div>
  </section>
</Layout>
