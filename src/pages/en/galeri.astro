---
import Layout from '../../layouts/Layout.astro';

// Asumsi kita memakai gambar dari /public/images
const galleryImages = [
  { src: '/images/gambar depan homestay widodo.jpeg', alt: 'Homestay Slamet Widodo Front View' },
  { src: '/images/kamar homestay 1.jpeg', alt: 'Main Room 1' },
  { src: '/images/kamar homestay 2.jpeg', alt: 'Main Room 2' },
  { src: '/images/kamar homestay 3.jpeg', alt: 'Main Room 3' },
  { src: '/images/kamar homestay.jpeg', alt: 'Joglo Room' },
  { src: '/images/kamar homestay borobudur.jpeg', alt: 'Room Interior' },
  { src: '/images/pemandangan borobudur.webp', alt: 'Surrounding View' },
];
---

<Layout 
  title="Gallery" 
  description="Gallery of photos of rooms and atmosphere at Homestay Slamet Widodo."
  lang="en"
>
  <section class="bg-terracotta-500 py-20 px-4 text-center">
    <div class="container mx-auto">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-cream-100 mb-4">Photo Gallery</h1>
      <p class="text-xl text-cream-200 max-w-2xl mx-auto">
        A glimpse of the comfort and authenticity of the atmosphere we offer.
      </p>
    </div>
  </section>

  <section class="py-16 px-4 bg-cream-50 min-h-screen">
    <div class="container mx-auto max-w-6xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {galleryImages.map((img, index) => (
          <div 
            class="group relative h-64 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all cursor-pointer bg-white"
            onclick={`document.getElementById('lightbox-${index}').showModal(); document.getElementById('lightbox-${index}').classList.remove('hidden', 'opacity-0');`}
          >
            <img 
              src={img.src} 
              alt={img.alt} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end">
              <span class="text-white font-medium p-4">{img.alt}</span>
            </div>
          </div>

          <!-- Lightbox Dialog Native HTML5 -->
          <dialog 
            id={`lightbox-${index}`} 
            class="backdrop:bg-black/90 p-0 m-auto bg-transparent border-none max-w-[90vw] max-h-[90vh] shadow-2xl rounded-xl hidden opacity-0 transition-opacity duration-300 open:flex flex-col items-center justify-center z-50"
          >
            <div class="relative flex flex-col items-center justify-center w-full h-full">
              <!-- Tombol Close -->
              <button 
                onclick={`const d = document.getElementById('lightbox-${index}'); d.classList.add('hidden', 'opacity-0'); setTimeout(() => d.close(), 300);`}
                class="absolute -top-12 right-0 text-white hover:text-gold-500 transition-colors bg-black/50 hover:bg-black p-2 rounded-full backdrop-blur-sm"
                aria-label="Close"
              >
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
              
              <!-- Gambar Full -->
              <img 
                src={img.src} 
                alt={img.alt} 
                class="max-w-full max-h-[85vh] object-contain rounded-lg shadow-2xl border-4 border-white/10"
              />
              <p class="text-white mt-4 text-center font-medium bg-black/50 px-4 py-1 rounded-full backdrop-blur-sm">{img.alt}</p>
            </div>
          </dialog>
        ))}
      </div>
    </div>
  </section>

  <!-- Script untuk menutup lightbox saat klik backdrop -->
  <script>
    document.querySelectorAll('dialog').forEach(dialog => {
      dialog.addEventListener('click', (e) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height
          && rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
        if (!isInDialog) {
          dialog.classList.add('hidden', 'opacity-0');
          setTimeout(() => dialog.close(), 300);
        }
      });
    });
  </script>
</Layout>
