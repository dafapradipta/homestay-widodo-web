<script>
  // Simple active state logic
  document.addEventListener('astro:page-load', () => {
    const path = window.location.pathname;
    const items = document.querySelectorAll('.nav-item');
    items.forEach(item => {
      if(item.getAttribute('href') === path || (path !== '/' && item.getAttribute('href')?.startsWith(path))) {
        item.classList.remove('text-terracotta-400');
        item.classList.add('text-terracotta-500');
        item.classList.add('scale-110');
      }
    });
  });
</script>
