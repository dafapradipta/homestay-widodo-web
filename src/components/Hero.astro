---
// Hero Section
const locale = Astro.currentLocale || "id";
const isEn = locale === "en";

const t = {
  h1: isEn ? "Affordable & Comfortable Homestay Near Borobudur" : "Homestay Murah & Nyaman Dekat Candi Borobudur",
  p: isEn ? "Comfortable accommodation with traditional Javanese touches, offering natural tranquility for your vacation." : "Penginapan yang nyaman dengan sentuhan tradisional Jawa, menyajikan ketenangan alam untuk liburan Anda.",
  btn: isEn ? "Book via WhatsApp" : "Booking via WhatsApp",
  waMsg: isEn ? "Hello, I want to ask about room availability at Homestay Slamet Widodo" : "Halo, saya mau tanya ketersediaan kamar di Homestay Slamet Widodo"
};
---
<section class="relative w-full h-[80vh] flex items-center justify-center overflow-hidden bg-terracotta-500">
  <div class="absolute inset-0 z-0">
    <!-- Ganti dengan astro:assets Image setelah folder gambar-homestay tersedia -->
    <img src="/images/gambar depan homestay widodo.jpeg" alt="Homestay Slamet Widodo Tampak Depan" class="w-full h-full object-cover opacity-60" loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-terracotta-500/80 to-transparent"></div>
  </div>
  
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-16">
    <h1 class="text-4xl md:text-6xl font-serif font-bold text-cream-100 mb-6 drop-shadow-md">
      {t.h1}
    </h1>
    <p class="text-lg md:text-xl text-cream-200 mb-8 max-w-2xl mx-auto font-medium drop-shadow-sm">
      {t.p}
    </p>
    <a href={`https://wa.me/6288225386498?text=${encodeURIComponent(t.waMsg)}`} target="_blank" rel="noopener noreferrer" class="inline-block bg-gold-500 hover:bg-[#b59555] text-white font-bold py-3 px-8 rounded-full shadow-lg transition-transform hover:scale-105">
      {t.btn}
    </a>
  </div>
</section>
