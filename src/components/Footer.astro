---
const year = new Date().getFullYear();
const locale = Astro.currentLocale || "id";
const isEn = locale === "en";

const t = {
  desc: isEn ? "Comfortable and authentic Javanese homestay near Borobudur Temple." : "Penginapan asri dan nyaman dengan nuansa tradisional Jawa, dekat dengan Candi Borobudur.",
  contact: isEn ? "Contact & Address" : "Kontak & Alamat",
  nav: isEn ? "Navigation" : "Navigasi",
  home: isEn ? "Home" : "Beranda",
  rooms: isEn ? "Rooms" : "Kamar",
  attractions: isEn ? "Nearby Attractions" : "Wisata Terdekat"
};
---
<footer class="bg-terracotta-500 text-cream-100 py-12 mt-16">
  <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div>
      <h3 class="text-xl font-serif font-bold mb-4">Homestay Slamet Widodo</h3>
      <p class="text-cream-200">{t.desc}</p>
    </div>
    <div>
      <h3 class="text-xl font-serif font-bold mb-4">{t.contact}</h3>
      <p class="text-cream-200">
        Sembungan, RT.01/RW.01, Sendaran, Kembanglimus,<br/>
        Kec. Borobudur, Kabupaten Magelang,<br/>
        Jawa Tengah 56553<br/>
        <br/>
        WhatsApp: <a href="https://wa.me/6288225386498" class="hover:text-gold-500">+62 882-2538-6498</a>
      </p>
    </div>
    <div>
      <h3 class="text-xl font-serif font-bold mb-4">{t.nav}</h3>
      <ul class="flex flex-col gap-2 text-cream-200">
        <li><a href={isEn ? "/en" : "/"} class="hover:text-gold-500 transition-colors">{t.home}</a></li>
        <li><a href={isEn ? "/en/kamar" : "/kamar"} class="hover:text-gold-500 transition-colors">{t.rooms}</a></li>
        <li><a href={isEn ? "/en/lokasi-wisata" : "/lokasi-wisata"} class="hover:text-gold-500 transition-colors">{t.attractions}</a></li>
      </ul>
    </div>
  </div>
  <div class="text-center text-cream-200 text-sm mt-12 pt-4 border-t border-terracotta-400/50">
    &copy; {year} Homestay Slamet Widodo. All rights reserved.
  </div>
</footer>
