---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppSticky from '../components/WhatsAppSticky.astro';

interface Props {
	title: string;
	description?: string;
}

const { 
	title, 
	description = "Homestay Slamet Widodo - Penginapan nyaman, hangat, dan asri dekat Candi Borobudur, Punthuk Setumbu, dan Gereja Ayam Bukit Rhema." 
} = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<!-- Mobile UX & PWA SEO -->
		<meta name="theme-color" content="#C25A38" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="Homestay Widodo" />

		<!-- SEO Meta Tags -->
		<title>{title} | Homestay Murah dekat Candi Borobudur</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="homestay borobudur, penginapan borobudur, homestay murah borobudur, penginapan dekat candi borobudur, homestay keluarga borobudur, homestay slamet widodo, sendaran kembanglimus, penginapan magelang, desa wisata borobudur" />
		<meta name="author" content="Homestay Slamet Widodo" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="canonical" href={Astro.url.href} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:title" content={`${title} | Homestay Murah dekat Candi Borobudur`} />
		<meta property="og:description" content="Booking langsung via WhatsApp! Penginapan nyaman, murah, dan asri di Borobudur. Fasilitas lengkap untuk keluarga & rombongan." />
		<meta property="og:image" content="https://homestay-widodo.vercel.app/images/gambar%20depan%20homestay%20widodo.jpeg" />
		<meta property="og:site_name" content="Homestay Slamet Widodo" />
		<meta property="og:locale" content="id_ID" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url.href} />
		<meta property="twitter:title" content={`${title} | Homestay Murah dekat Candi Borobudur`} />
		<meta property="twitter:description" content="Booking langsung via WhatsApp! Penginapan nyaman, murah, dan asri di Borobudur. Fasilitas lengkap untuk keluarga & rombongan." />
		<meta property="twitter:image" content="https://homestay-widodo.vercel.app/images/gambar%20depan%20homestay%20widodo.jpeg" />
		
		<!-- Preconnect and Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
		
		<!-- JSON-LD Schema -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "LodgingBusiness",
				"name": "Homestay Slamet Widodo",
				"image": "https://homestay-widodo.vercel.app/images/gambar%20depan%20homestay%20widodo.jpeg",
				"description": "Penginapan nyaman, murah, dan asri dekat Candi Borobudur. Fasilitas lengkap, cocok untuk rombongan keluarga atau backpacker.",
				"url": "https://homestay-widodo.vercel.app",
				"telephone": "+6288225386498",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "Sendaran RT.3/RW.4, Kembanglimus",
					"addressLocality": "Borobudur",
					"addressRegion": "Jawa Tengah",
					"postalCode": "56553",
					"addressCountry": "ID"
				},
				"geo": {
					"@type": "GeoCoordinates",
					"latitude": "-7.620000",
					"longitude": "110.190000"
				},
				"hasMap": "https://maps.app.goo.gl/T9gEuSuwrKSerzmw7",
				"priceRange": "Rp 99.000 - Rp 299.000",
				"aggregateRating": {
					"@type": "AggregateRating",
					"ratingValue": "4.8",
					"reviewCount": "24"
				},
				"amenityFeature": [
					{
						"@type": "LocationFeatureSpecification",
						"name": "Free Wi-Fi",
						"value": "True"
					},
					{
						"@type": "LocationFeatureSpecification",
						"name": "Air Conditioning",
						"value": "True"
					}
				]
			}
		</script>
		<!-- FAQ Schema (SEO Hacks untuk PAA Google) -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [{
					"@type": "Question",
					"name": "Berapa harga menginap di Homestay Slamet Widodo Borobudur?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Harga menginap mulai dari Rp 99.000 per malam untuk tipe kamar Joglo, dan Rp 299.000 untuk tipe Family Room. Booking langsung via WhatsApp untuk harga terbaik."
					}
				}, {
					"@type": "Question",
					"name": "Apakah Homestay Slamet Widodo dekat dengan Candi Borobudur?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Ya, sangat dekat. Lokasi kami berada di Sendaran, Kembanglimus yang hanya berjarak beberapa menit berkendara dari kawasan wisata Candi Borobudur."
					}
				}, {
					"@type": "Question",
					"name": "Apakah ada fasilitas AC dan WiFi di Homestay Borobudur ini?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Tentu, kami menyediakan fasilitas kamar ber-AC, Free WiFi kencang, TV, air panas, dan area parkir luas untuk kenyamanan tamu."
					}
				}]
			}
		</script>
		<!-- Breadcrumb Schema -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "BreadcrumbList",
				"itemListElement": [{
					"@type": "ListItem",
					"position": 1,
					"name": "Beranda",
					"item": "https://homestay-widodo.vercel.app/"
				},{
					"@type": "ListItem",
					"position": 2,
					"name": "Kamar",
					"item": "https://homestay-widodo.vercel.app/kamar"
				}]
			}
		</script>
		
		<ClientRouter />
	</head>
	<body class="flex flex-col min-h-screen">
		<Navbar />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
		<WhatsAppSticky />
		
		<script>
			document.addEventListener('astro:page-load', () => {
				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('active');
						}
					});
				}, { threshold: 0.1 });

				document.querySelectorAll('.reveal').forEach((el) => {
					observer.observe(el);
				});
			});
		</script>
	</body>
</html>
